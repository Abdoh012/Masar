# Figma extraction config — copy this file to .figma.env and fill in values.
# .figma.env is gitignored; never commit real token values.

# Personal Access Token:
#   Figma -> Account settings -> Security -> Personal access tokens
#   Requires the target file to be accessible to your account ("view" is enough).
FIGMA_TOKEN=

# File key = the id in the Figma share URL:
#   https://www.figma.com/file/<FILE_KEY>/<name>?node-id=...
FIGMA_FILE_KEY=