# Base URL of the MASAR PHP API, including the /api/v1 prefix.
# Local: Laragon/Apache serves the backend from the repo root (see backend/docs/SETUP_LARAGON.md)
#        or `php -S localhost:8000 -t public` from backend/.
# Vercel: must be the PUBLIC https URL of the deployed backend — the frontend fetches it
#         server-side (serverFetch), so a localhost URL is unreachable from Vercel's runtime.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Public base URL of this frontend. Used for absolute links/metadata.
# Vercel: set per deployment (production vs. preview domains differ).
NEXT_PUBLIC_SITE_URL=http://localhost:3000