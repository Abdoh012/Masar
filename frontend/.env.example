# Base URL of the MASAR backend API. Copy this file to `.env.local` and adjust
# if the backend runs somewhere other than the default Laragon setup.
# Do not include a trailing slash or `/api/v1` will be duplicated.
NEXT_PUBLIC_API_URL=http://localhost/Masar/backend/api/v1

# Public URL of this frontend, used for absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
