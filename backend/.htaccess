<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve Authorization header for PHP/FastCGI
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteBase /masar-backend/
    DirectoryIndex public/index.php index.php

    # If the request already targets the public folder, do nothing.
    RewriteRule ^public/ - [L]

    # Route root and other non-file/non-dir requests to public/index.php (internal rewrite)
    RewriteRule ^$ public/index.php [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>
