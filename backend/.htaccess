<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve Authorization header for PHP/FastCGI
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    DirectoryIndex public/index.php index.php

    # Deny direct HTTP access to sensitive files and directories.
    # All patterns are relative to this project directory, so they are
    # portable across machines and require no Apache configuration.
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.env\.example$ - [F,L]
    RewriteRule ^\.git/ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule ^(app|database|routes|storage|tests|docs|postman|\.postman|vendor)(/|$) - [F,L]
    # Block direct HTTP execution of cron CLI scripts, while keeping the
    # routed /cron and /cron/run API endpoints working.
    RewriteRule ^cron/.*\.php$ - [F,L]
    RewriteRule ^cron/?$ public/index.php [L,QSA]

    # If the request already targets the public folder, do nothing.
    RewriteRule ^public/ - [L]

    # Route root and other non-file/non-dir requests to public/index.php (internal rewrite)
    RewriteRule ^$ public/index.php [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>