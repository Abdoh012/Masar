# ============================================================
# MASAR Backend - Environment Example
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Masar/backend
APP_TIMEZONE=Africa/Cairo
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masar
DB_USERNAME=root
DB_PASSWORD=

# Mail (SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="MASAR"
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=
MAIL_VERIFICATION_ENABLED=true

# Uploads (paths are relative to the backend directory unless absolute)
UPLOAD_STORAGE_PATH=storage/uploads
UPLOAD_PUBLIC_URL=/storage/uploads

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/Masar/backend/api/v1/auth/google/callback

# reCAPTCHA
RECAPTCHA_ENABLED=false
RECAPTCHA_VERSION=v2
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_MIN_SCORE=0.5

# JWT (generate a long random secret for JWT_SECRET in every environment)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# CSRF
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Security
SECURE_COOKIES=true
RATE_LIMIT_ENABLED=false

# Reserved / not currently read by app/config (kept for local tooling and docs)
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
