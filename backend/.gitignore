# ============================================================

# MASAR Git Ignore

# ============================================================

# Environment / secrets

.env
.env.local
.env.*.local

# Composer

/vendor/

# Runtime storage

/storage/logs/*
/storage/cache/*
/storage/uploads/*
/storage/certificates/*

# Runtime uploads written by app/core/helpers/upload.php
/app/storage/uploads/*
/app/storage/cache/*
/app/storage/logs/*

# Keep required directories

!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/certificates/.gitkeep

# Temporary files

*.tmp
*.temp
*.swp
*.swo

# IDE

.idea/
.vscode/
*.code-workspace

# OS

.DS_Store
Thumbs.db

# Logs

*.log

# Coverage

coverage/
.phpunit.result.cache

# Testing

.phpunit.cache/

# Local databases

*.sqlite
*.sqlite3

# Postman local workspace (auto-generated from Postman Cloud)

.postman/
postman/

# Generated files

*.generated.php

# Loose upload artifacts written outside /storage/uploads (e.g. manual test files)

/uploads/

# Quality tool caches

.php-cs-fixer.cache

# Backup files

*.bak
*.backup
*~

# Node (if frontend tooling is added later)

node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
