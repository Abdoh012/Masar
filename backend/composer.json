{
  "name": "masar/masar-backend",
  "description": "MASAR training and internship management backend",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "google/apiclient": "^2.19",
    "phpmailer/phpmailer": "^7.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "MASAR\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MASAR\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 1800
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  }
}
