# Normalize line endings for text files.
* text=auto

# Source files: force LF on commit/checkout (CI runs on Linux).
*.php text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.htaccess text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf

# Binary assets: never normalize.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.pdf binary
*.ico binary
*.woff2 binary

# Windows-specific helper files are not source.
*.bat text eol=crlf