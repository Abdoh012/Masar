<IfModule mod_rewrite.c>
	RewriteEngine On

	# Preserve Authorization header for PHP/FastCGI
	RewriteCond %{HTTP:Authorization} .
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

	DirectoryIndex index.php

	# Deny direct HTTP access to sensitive files that may be placed inside public/
	RewriteRule ^\.env$ - [F,L]
	RewriteRule ^\.env\.example$ - [F,L]

	# Route all non-file/non-dir requests to index.php (front controller)
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.php [L]
</IfModule>